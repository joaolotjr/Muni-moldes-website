# Variáveis do docker-compose.yml. Copie este arquivo para ".env" (aqui na raiz) e preencha.
# O ".env" não vai para o git. As variáveis da API ficam em backend-moldes/.env.example
# e as do site em frontend-moldes/.env.example.

# ---------------------------------------------------------------- Garage (armazenamento das fotos)
# [obrigatórias para subir o contêiner "garage"] Gere cada uma com: openssl rand -hex 32
# Segredo interno usado na comunicação do nó (e pelo comando "garage" dentro do contêiner).
GARAGE_RPC_SECRET=
# Senha da API de administração do Garage (porta 3903, não exposta fora do contêiner).
GARAGE_ADMIN_TOKEN=

# Observação: usuário, senha e nome do banco Postgres ainda estão fixos no docker-compose.yml
# (user_admin / senha_segura / catalogo_db) e precisam bater com DB_* em backend-moldes/.env.
