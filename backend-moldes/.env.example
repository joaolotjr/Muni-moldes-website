# Copie para .env e ajuste os valores.
PORT=3333

# Banco de dados (mesmos valores do docker-compose.yml na raiz)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=user_admin
DB_PASSWORD=senha_segura
DB_NAME=catalogo_db
# Em produção use false
DB_SYNCHRONIZE=true

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor

# Primeiro administrador, criado na inicialização se não houver nenhum usuário
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# Armazenamento das fotos (compatível com S3). Sem S3_BUCKET, as fotos vão para ./uploads.
# Local: Garage do docker-compose (veja garage/README.md para criar o bucket e a chave).
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=muni-moldes
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true para Garage/MinIO; em provedores como R2 e B2 normalmente também funciona
S3_FORCE_PATH_STYLE=true
