# Variáveis do backend. Copie este arquivo para ".env" (nesta pasta) e ajuste os valores.
# O ".env" não vai para o git. Ao criar uma variável nova no código, inclua-a aqui também.
#
# [obrigatória] sem ela o backend não inicia   [opcional] tem valor padrão, mostrado no exemplo

# ---------------------------------------------------------------- Servidor
# [opcional] Porta da API. O frontend espera 3333 quando VITE_API_URL não está definida.
PORT=3333

# ---------------------------------------------------------------- Banco de dados (Postgres)
# Os valores abaixo são os do docker-compose.yml na raiz. Em produção, troque usuário e senha.
# [opcional]
DB_HOST=127.0.0.1
# [opcional]
DB_PORT=5433
# [obrigatória]
DB_USER=user_admin
# [obrigatória]
DB_PASSWORD=senha_segura
# [obrigatória]
DB_NAME=catalogo_db
# [opcional] true: cria e altera as tabelas sozinho ao iniciar. Em produção use false.
DB_SYNCHRONIZE=true

# ---------------------------------------------------------------- Login do painel
# [obrigatória] Chave que assina os tokens de login. Trocar o valor desloga todo mundo.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor

# Primeiro administrador. Só é usado na inicialização quando ainda não existe nenhum usuário;
# depois disso, mudar estes valores não altera o login já criado.
# [opcional]
ADMIN_NAME=Administrador
# [opcional, mas sem e-mail e senha nenhum administrador é criado]
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# [opcional, padrão 5] Minutos sem atividade até o painel encerrar a sessão.
SESSION_IDLE_MINUTES=5

# ---------------------------------------------------------------- Fotos dos moldes
# Sem S3_BUCKET, as fotos são gravadas na pasta ./uploads desta máquina.
# Com S3_BUCKET, vão para um serviço compatível com S3, e as duas chaves passam a ser obrigatórias.
#
# Garage local (docker-compose): crie o bucket e a chave seguindo garage/README.md,
# depois descomente o bloco e preencha as duas chaves.
#S3_ENDPOINT=http://127.0.0.1:3900
#S3_REGION=garage
#S3_BUCKET=muni-moldes
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_FORCE_PATH_STYLE=true
#
# Em um provedor (Cloudflare R2, Backblaze B2, AWS S3...): use o endpoint, a região e as chaves
# que o painel do provedor informar. S3_FORCE_PATH_STYLE=true coloca o bucket no caminho da URL
# (necessário no Garage); confira na documentação do provedor qual formato ele espera.
# Padrões quando omitidas: S3_REGION=us-east-1, S3_FORCE_PATH_STYLE=false, S3_ENDPOINT=o da AWS.
